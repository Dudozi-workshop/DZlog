+++ b/dzlog/data/counterseed/CounterSeedRepository.kt
@@ -0,0 +1,58 @@
+package com.example.dzlog.data.counterseed
+
+import android.content.Context
+import com.example.dzlog.data.log.LogDatabase
+
+/**
+ * CounterSeed 접근 레이어.
+ * - 키: (relativePath, scopePrefix)
+ * - 값: effectiveSeed (다음 촬영에 사용할 번호)
+ */
+class CounterSeedRepository private constructor(
+    private val dao: CounterSeedDao
+) {
+
+    suspend fun getEffectiveSeed(
+        relativePath: String,
+        scopePrefix: String
+    ): Int? =
+        dao.getEffectiveSeed(relativePath, scopePrefix)
+
+    suspend fun setEffectiveSeed(
+        relativePath: String,
+        scopePrefix: String,
+        effectiveSeed: Int
+    ) {
+        if (relativePath.isBlank()) return
+        if (scopePrefix.isBlank()) return
+        if (effectiveSeed < 0) return
+
+        val nowSec = System.currentTimeMillis() / 1000L
+        dao.upsert(
+            CounterSeedEntity(
+                relativePath = relativePath,
+                scopePrefix = scopePrefix,
+                effectiveSeed = effectiveSeed,
+                updatedAtSeconds = nowSec
+            )
+        )
+    }
+
+    suspend fun deleteScope(
+        relativePath: String,
+        scopePrefix: String
+    ) {
+        if (relativePath.isBlank()) return
+        if (scopePrefix.isBlank()) return
+        dao.deleteScope(relativePath, scopePrefix)
+    }
+
+    companion object {
+        @Volatile
+        private var INSTANCE: CounterSeedRepository? = null
+
+        fun getInstance(context: Context): CounterSeedRepository =
+            INSTANCE ?: synchronized(this) {
+                INSTANCE ?: CounterSeedRepository(
+                    LogDatabase.getInstance(context).counterSeedDao()
+                ).also { INSTANCE = it }
+            }
+    }
+}
