--- /dev/null
+++ b/dzlog/data/counterseed/CounterSeedDao.kt
@@ -0,0 +1,41 @@
+package com.example.dzlog.data.counterseed
+
+import androidx.room.Dao
+import androidx.room.Insert
+import androidx.room.OnConflictStrategy
+import androidx.room.Query
+
+@Dao
+interface CounterSeedDao {
+
+    @Insert(onConflict = OnConflictStrategy.REPLACE)
+    suspend fun upsert(entity: CounterSeedEntity): Long
+
+    @Query(
+        "SELECT effectiveSeed FROM counter_seed WHERE relativePath = :relativePath AND scopePrefix = :scopePrefix LIMIT 1"
+    )
+    suspend fun getEffectiveSeed(
+        relativePath: String,
+        scopePrefix: String
+    ): Int?
+
+    @Query(
+        "DELETE FROM counter_seed WHERE relativePath = :relativePath AND scopePrefix = :scopePrefix"
+    )
+    suspend fun deleteScope(
+        relativePath: String,
+        scopePrefix: String
+    )
+}
diff --git a/dzlog/data/counterseed/CounterSeedRepository.kt b/dzlog/data/counterseed/CounterSeedRepository.kt
