+package com.example.dzlog.data.counterseed
+
+import androidx.room.Entity
+import androidx.room.Index
+import androidx.room.PrimaryKey
+
+/**
+ * (relativePath, scopePrefix) 단위 카운터 시드 저장소.
+ * - 테이블 표시 여부와 무관
+ * - 실제 촬영에 사용되는 카운터 값(effectiveSeed)을 관리
+ */
+@Entity(
+    tableName = "counter_seed",
+    indices = [
+        Index(value = ["relativePath", "scopePrefix"], unique = true),
+        Index(value = ["relativePath"]),
+        Index(value = ["scopePrefix"])
+    ]
+)
+data class CounterSeedEntity(
+    @PrimaryKey(autoGenerate = true)
+    val id: Long = 0L,
+    val relativePath: String,
+    val scopePrefix: String,
+    val effectiveSeed: Int,
+    val updatedAtSeconds: Long
+)
diff --git a/dzlog/data/counterseed/CounterSeedDao.kt b/dzlog/data/counterseed/CounterSeedDao.kt
